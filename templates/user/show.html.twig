{% extends 'base.html.twig' %}

{% block title %}LibraShelf | Utilisateur{% endblock %}

{% block body %}
    <div class="container pt-3">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h1 class="mb-4">Détails du compte</h1>

                <div class="card">
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th style="width: 150px;">ID</th>
                                    <td>{{ user.id }}</td>
                                </tr>
                                <tr>
                                    <th>Email</th>
                                    <td>{{ user.email }}</td>
                                </tr>
                                <tr>
                                    <th>Rôles</th>
                                    <td>
                                        {% for role in user.roles %}
                                            <span class="badge bg-primary">{{ role }}</span>
                                        {% endfor %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a class="btn btn-primary" href="{{ path('app_user_index') }}">Retour à la liste</a>
                    <a class="btn btn-warning" href="{{ path('app_user_edit', {'id': user.id}) }}">Éditer</a>
                    {{ include('user/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
