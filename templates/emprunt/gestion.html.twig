{% extends 'base.html.twig' %}

{% block title %}LibraShelf | Gestion des Emprunts{% endblock %}

{% block body %}
    <div class="container pt-3">
        <div class="row">
            <div class="col-12">
                <h1 class="mb-4">Gestion des emprunts</h1>

                <ul class="nav nav-tabs mb-4" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#actifs" type="button">
                            Emprunts actifs <span class="badge bg-primary">{{ empruntsActifs|length }}</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#retards" type="button">
                            En retard <span class="badge bg-danger">{{ empruntsEnRetard|length }}</span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="actifs" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Utilisateur</th>
                                        <th>Ouvrage</th>
                                        <th>Cote</th>
                                        <th>Date d'emprunt</th>
                                        <th>Date retour prévue</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for emprunt in empruntsActifs %}
                                    <tr class="{% if emprunt.isEnRetard() %}table-danger{% endif %}">
                                        <td>{{ emprunt.user.email }}</td>
                                        <td>{{ emprunt.exemplaire.ouvrage.titre }}</td>
                                        <td>{{ emprunt.exemplaire.cote }}</td>
                                        <td>{{ emprunt.dateEmprunt|date('d/m/Y') }}</td>
                                        <td>
                                            {{ emprunt.dateRetourPrevue|date('d/m/Y') }}
                                            {% if emprunt.isEnRetard() %}
                                                <br><span class="badge bg-danger">{{ emprunt.joursRetard }} jours de retard</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if emprunt.statut == 'en_cours' %}
                                                <span class="badge bg-primary">En cours</span>
                                            {% elseif emprunt.statut == 'en_retard' %}
                                                <span class="badge bg-danger">En retard</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_exemplaire_show', {'id': emprunt.exemplaire.id}) }}" class="btn btn-sm btn-info">Voir</a>
                                            <form method="post" action="{{ path('app_emprunt_retour', {'id': emprunt.id}) }}" style="display: inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('retour' ~ emprunt.id) }}">
                                                <button type="submit" class="btn btn-sm btn-success">Retour</button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="retards" role="tabpanel">
                        {% if empruntsEnRetard is empty %}
                            <div class="alert alert-success">
                                Aucun emprunt en retard. Excellent !
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-striped table-danger">
                                    <thead>
                                        <tr>
                                            <th>Utilisateur</th>
                                            <th>Ouvrage</th>
                                            <th>Date retour prévue</th>
                                            <th>Jours de retard</th>
                                            <th>Pénalité</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for emprunt in empruntsEnRetard %}
                                        <tr>
                                            <td>{{ emprunt.user.email }}</td>
                                            <td>{{ emprunt.exemplaire.ouvrage.titre }}</td>
                                            <td>{{ emprunt.dateRetourPrevue|date('d/m/Y') }}</td>
                                            <td><strong>{{ emprunt.joursRetard }}</strong> jours</td>
                                            <td><strong>{{ (emprunt.joursRetard * 0.50)|number_format(2) }}€</strong></td>
                                            <td>
                                                <a href="{{ path('app_exemplaire_show', {'id': emprunt.exemplaire.id}) }}" class="btn btn-sm btn-info">Voir</a>
                                                <form method="post" action="{{ path('app_emprunt_retour', {'id': emprunt.id}) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('retour' ~ emprunt.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-success">Retour</button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
