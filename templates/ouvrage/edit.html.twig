{% extends 'base.html.twig' %}

{% block title %}LibraShelf | Édition Ouvrage{% endblock %}

{% block body %}
    <div class="container pt-3">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <h1 class="mb-4">Modifier un ouvrage</h1>

                <div class="card">
                    <div class="card-body">
                        {{ include('ouvrage/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                    </div>
                </div>

                <div class="mt-3">
                    <a class="btn btn-primary" href="{{ path('app_ouvrage_index') }}">Retour à la liste</a>
                    {{ include('ouvrage/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
