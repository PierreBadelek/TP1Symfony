{% extends 'base.html.twig' %}

{% block title %}LibraShelf | Ouvrage{% endblock %}

{% block body %}
    <div class="container pt-3">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <h1 class="mb-4">Détails de l'ouvrage</h1>

                <div class="card">
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                            <tr>
                                <th style="width: 150px;">ID</th>
                                <td>{{ ouvrage.id }}</td>
                            </tr>
                            <tr>
                                <th>Titre</th>
                                <td><strong>{{ ouvrage.titre }}</strong></td>
                            </tr>
                            <tr>
                                <th>Éditeur</th>
                                <td>{{ ouvrage.editeur }}</td>
                            </tr>
                            <tr>
                                <th>ISBN</th>
                                <td>{{ ouvrage.ISBN }}</td>
                            </tr>
                            <tr>
                                <th>Année</th>
                                <td>{{ ouvrage.annee }}</td>
                            </tr>
                            <tr>
                                <th>Catégories</th>
                                <td>
                                    {% for cat in ouvrage.categories %}
                                        <span class="badge bg-info">{{ cat.categorienom }}</span>
                                    {% endfor %}
                                </td>
                            </tr>
                            <tr>
                                <th>Auteurs</th>
                                <td>
                                    {% for aut in ouvrage.auteurs %}
                                        <span class="badge bg-secondary">{{ aut.nom }} {{ aut.prenom }}</span>
                                    {% endfor %}
                                </td>
                            </tr>
                            <tr>
                                <th>Résumé</th>
                                <td>{{ ouvrage.resume }}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="{{ path('app_exemplaire_index', {
                        Ouvrage: ouvrage.id,
                        disponible: true
                    }) }}" class="btn btn-success">
                        Voir exemplaires disponibles
                    </a>
                    <a class="btn btn-primary" href="{{ path('app_ouvrage_index') }}">Retour aux ouvrages</a>
                    <a class="btn btn-warning" href="{{ path('app_ouvrage_edit', {'id': ouvrage.id}) }}">Modifier</a>
                    {{ include('ouvrage/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
