{% extends 'base.html.twig' %}

{% block title %}Ouvrage{% endblock %}

{% block body %}
    <div class="container pt-10">
        <h1>Ouvrage</h1>

        <table class="table ">
            <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ouvrage.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ ouvrage.titre }}</td>
            </tr>
            <tr>
                <th>Editeur</th>
                <td>{{ ouvrage.editeur }}</td>
            </tr>
            <tr>
                <th>ISBN</th>
                <td>{{ ouvrage.ISBN }}</td>
            </tr>
            <tr>
                <th>Annee</th>
                <td>{{ ouvrage.annee }}</td>
            </tr>
            <tr>
                <th>Catégories</th>
                <td>
                    {% for cat in ouvrage.categories %}
                        {{ cat.categorienom }} /
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <th>Auteurs</th>
                <td>
                    {% for aut in ouvrage.auteurs %}
                        {{ aut.nom }} {{ aut.prenom }} /
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <th>Resume</th>
                <td>{{ ouvrage.resume }}</td>
            </tr>

            </tbody>
        </table>
        <a href="{{ path('app_exemplaire_index', {
            Ouvrage: ouvrage.id,
            disponible: true
        }) }}" class="btn btn-success">
            Voir exemplaires disponibles
        </a>
        <br>

        <a class="btn btn-primary" href="{{ path('app_ouvrage_index') }}">Retour aux ouvrages</a>
        <a class="btn btn-warning" href="{{ path('app_ouvrage_edit', {'id': ouvrage.id}) }}">Modifier</a>
        {{ include('ouvrage/_delete_form.html.twig') }}

    </div>


{% endblock %}
