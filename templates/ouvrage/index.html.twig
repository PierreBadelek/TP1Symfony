{% extends 'base.html.twig' %}

{% block title %}LibraShelf | Catalogue Ouvrage {% endblock %}


{% block body %}
    <div class="container pt-3">
        <div class="row justify-content-center">
            <h1> Ouvrages </h1>
            <!-- Colonne de gauche -->
            <div class="col-2">
                <div class="h4 p-3">Filtre</div>
                {{ form_start(form) }}
                {{ form_row(form.titre) }}
                {{ form_row(form.ISBN) }}
                {{ form_row(form.annee) }}
                {{ form_row(form.categories) }}

                <button type="submit" class="btn btn-primary">Rechercher</button>
                {{ form_end(form) }}


            </div>

            <!-- Colonne centrale large -->
            <div class="col-10">
                <table class="table table-striped ">
                    <thead>
                    <tr>
                        <th>Titre</th>
                        <th>ISBN</th>
                        <th>Editeur</th>
                        <th>Categorie</th>
                        <th>Année</th>
                        <th>Auteurs</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for ouvrage in lesOuvrages %}
                        <tr class="ligne-table-ouvrage" onclick="window.location.href='{{ path('app_ouvrage_show', {'id': ouvrage.id}) }}';">
                            <td>{{ ouvrage.titre }}</td>
                            <td>{{ ouvrage.ISBN }}</td>
                            <td>{{ ouvrage.editeur }}</td>
                            <td>
                                {% for cat in ouvrage.categories %}
                                    {{ cat.categorienom }} /
                                {% endfor %}
                            </td>
                            <td>{{ ouvrage.annee }}</td>
                            <td>
                                {% for aut in ouvrage.auteurs %}
                                    {{ aut.nom }} /
                                {% endfor %}
                            </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5">no records found</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                {# Pagination #}
                {% if totalPages > 1 %}
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            {# Bouton Précédent #}
                            <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_ouvrage_index', {'page': currentPage - 1}) }}">Précédent</a>
                            </li>

                            {# Première page #}
                            {% if currentPage > 3 %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_ouvrage_index', {'page': 1}) }}">1</a>
                                </li>
                                {% if currentPage > 4 %}
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                {% endif %}
                            {% endif %}

                            {# Pages autour de la page courante #}
                            {% for i in range(max(1, currentPage - 2), min(totalPages, currentPage + 2)) %}
                                <li class="page-item {% if i == currentPage %}active{% endif %}">
                                    <a class="page-link" href="{{ path('app_ouvrage_index', {'page': i}) }}">{{ i }}</a>
                                </li>
                            {% endfor %}

                            {# Dernière page #}
                            {% if currentPage < totalPages - 2 %}
                                {% if currentPage < totalPages - 3 %}
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                {% endif %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_ouvrage_index', {'page': totalPages}) }}">{{ totalPages }}</a>
                                </li>
                            {% endif %}

                            {# Bouton Suivant #}
                            <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_ouvrage_index', {'page': currentPage + 1}) }}">Suivant</a>
                            </li>
                        </ul>
                    </nav>
                {% endif %}
            </div>
        </div>
    </div>
    </div>




{% endblock %}
