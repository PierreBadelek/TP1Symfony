{% extends 'base.html.twig' %}

{% block title %}LibraShelf | Exemplaire{% endblock %}

{% block body %}
    <div class="container pt-3">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <h1 class="mb-4">Détails de l'exemplaire</h1>

                <div class="card">
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th style="width: 150px;">ID</th>
                                    <td>{{ exemplaire.id }}</td>
                                </tr>
                                <tr>
                                    <th>Ouvrage</th>
                                    <td>
                                        <a href="{{ path('app_ouvrage_show', {'id': exemplaire.ouvrage.id}) }}">
                                            {{ exemplaire.ouvrage.titre }}
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Cote</th>
                                    <td><strong>{{ exemplaire.cote }}</strong></td>
                                </tr>
                                <tr>
                                    <th>État</th>
                                    <td>
                                        {% if exemplaire.etat == 'bon' %}
                                            <span class="badge bg-success">Bon</span>
                                        {% elseif exemplaire.etat == 'moyen' %}
                                            <span class="badge bg-warning">Moyen</span>
                                        {% else %}
                                            <span class="badge bg-danger">Mauvais</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Disponible</th>
                                    <td>
                                        {% if exemplaire.disponible %}
                                            <span class="badge bg-success">Oui</span>
                                        {% else %}
                                            <span class="badge bg-danger">Non</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    {% if exemplaire.disponible and is_granted('ROLE_USER') %}
                        <a href="{{ path('app_emprunt_new', {'id': exemplaire.id}) }}" class="btn btn-success btn-lg">
                            📚 Emprunter cet exemplaire
                        </a>
                    {% elseif not exemplaire.disponible %}
                        <button class="btn btn-secondary btn-lg" disabled>
                            ❌ Exemplaire indisponible
                        </button>
                    {% endif %}

                    <a class="btn btn-primary" href="{{ path('app_exemplaire_index') }}">Retour à la liste</a>

                    {% if is_granted('ROLE_LIBRARIAN') %}
                        <a class="btn btn-warning" href="{{ path('app_exemplaire_edit', {'id': exemplaire.id}) }}">Modifier</a>
                        {{ include('exemplaire/_delete_form.html.twig') }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
