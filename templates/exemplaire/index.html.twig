{% extends 'base.html.twig' %}

{% block title %}Liste des exemplaires{% endblock %}

{% block body %}
    <div class="container pt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Liste des exemplaires</h1>
            {% if is_granted('ROLE_LIBRARIAN') %}
                <a class="btn btn-success" href="{{ path('app_exemplaire_new') }}">
                    <i class="bi bi-plus-circle"></i> Ajouter un exemplaire
                </a>
            {% endif %}
        </div>

        {# Filtres en haut dans une card #}
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="bi bi-funnel"></i> Filtres de recherche
                </h5>
                {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
                    <div class="col-md-3">
                        {{ form_row(form.cote, {'label': 'Cote'}) }}
                    </div>
                    <div class="col-md-3">
                        {{ form_row(form.etat, {'label': 'État'}) }}
                    </div>
                    <div class="col-md-3">
                        {{ form_row(form.disponible, {'label': 'Disponibilité'}) }}
                    </div>
                    <div class="col-md-3">
                        {{ form_row(form.Ouvrage, {'label': 'Ouvrage'}) }}
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Rechercher
                        </button>
                        <a href="{{ path('app_exemplaire_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Réinitialiser
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        {# Tableau responsive #}
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Titre</th>
                                <th>Cote</th>
                                <th>État</th>
                                <th class="text-center">Disponible</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for exemplaire in exemplaires %}
                            <tr>
                                <td class="fw-semibold">{{ exemplaire.ouvrage.getTitre() }}</td>
                                <td><span class="badge bg-secondary">{{ exemplaire.cote }}</span></td>
                                <td>
                                    {% set etatValue = exemplaire.etat.value|default(exemplaire.etat) %}
                                    {% if etatValue == 'NEW' %}
                                        <span class="badge bg-success">Neuf</span>
                                    {% elseif etatValue == 'CORRECT' %}
                                        <span class="badge bg-info">Correct</span>
                                    {% else %}
                                        <span class="badge bg-danger">Endommagé</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if exemplaire.disponible %}
                                        <span class="badge bg-success">Disponible</span>
                                    {% else %}
                                        <span class="badge bg-danger">Emprunté</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('app_exemplaire_show', {'id': exemplaire.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>

                                    {% if exemplaire.disponible and is_granted('ROLE_USER') %}
                                        <a href="{{ path('app_emprunt_new', {'id': exemplaire.id}) }}" class="btn btn-sm btn-success">Emprunter</a>
                                    {% endif %}

                                    {% if is_granted('ROLE_LIBRARIAN') %}
                                        <a href="{{ path('app_exemplaire_edit', {'id': exemplaire.id}) }}" class="btn btn-sm btn-warning">Éditer</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox"></i> Aucun exemplaire trouvé
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Pagination #}
        {% if totalPages > 1 %}
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    {# Bouton Précédent #}
                    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                        <a class="page-link" href="{{ path('app_exemplaire_index', {'page': currentPage - 1}) }}">Précédent</a>
                    </li>

                    {# Première page #}
                    {% if currentPage > 3 %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_exemplaire_index', {'page': 1}) }}">1</a>
                        </li>
                        {% if currentPage > 4 %}
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        {% endif %}
                    {% endif %}

                    {# Pages autour de la page courante #}
                    {% for i in range(max(1, currentPage - 2), min(totalPages, currentPage + 2)) %}
                        <li class="page-item {% if i == currentPage %}active{% endif %}">
                            <a class="page-link" href="{{ path('app_exemplaire_index', {'page': i}) }}">{{ i }}</a>
                        </li>
                    {% endfor %}

                    {# Dernière page #}
                    {% if currentPage < totalPages - 2 %}
                        {% if currentPage < totalPages - 3 %}
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        {% endif %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('app_exemplaire_index', {'page': totalPages}) }}">{{ totalPages }}</a>
                        </li>
                    {% endif %}

                    {# Bouton Suivant #}
                    <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                        <a class="page-link" href="{{ path('app_exemplaire_index', {'page': currentPage + 1}) }}">Suivant</a>
                    </li>
                </ul>
            </nav>
        {% endif %}

    </div>


{% endblock %}
