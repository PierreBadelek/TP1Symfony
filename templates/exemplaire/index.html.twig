    {% extends 'base.html.twig' %}

{% block title %}Exemplaire index{% endblock %}

{% block body %}
    <div class="container pt-3">
        <div class="row justify-content-center">
            <h1>Liste des exemplaires</h1>
        </div>
        <div class="col-2">
            <div class="h4 p-3">Filtre</div>
            {{ form_start(form) }}
            {{ form_row(form.cote) }}
            {{ form_row(form.etat) }}
            {{ form_row(form.disponible) }}
            {{ form_row(form.Ouvrage) }}

            <button type="submit" class="btn btn-primary">Rechercher</button>
            {{ form_end(form) }}


            {% if is_granted('ROLE_LIBRAIRIAN') %}
                <a class="btn btn-outline-info" href="{{ path('app_exemplaire_new') }}">Ajouter un exemplaire</a>
            {% endif %}
        </div>

        <table class="col-10 table">
            <thead>
            <tr>
                <th>Titre</th>
                <th>Cote</th>
                <th>Etat</th>
                <th>Disponible</th>
                <th>actions</th>
            </tr>
            </thead>
            <tbody>
            {% for exemplaire in exemplaires %}
                <tr>
                    <td>{{ exemplaire.ouvrage.getTitre() }}</td>
                    <td>{{ exemplaire.cote }}</td>
                    <td>{{ exemplaire.etat }}</td>
                    <td>{{ exemplaire.disponible ? 'Yes' : 'No' }}</td>
                    <td>
                        <a href="{{ path('app_exemplaire_show', {'id': exemplaire.id}) }}">show</a>
                        <a href="{{ path('app_exemplaire_edit', {'id': exemplaire.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun exemplaire disponible ! </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>


    </div>


{% endblock %}
