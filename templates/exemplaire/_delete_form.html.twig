<form method="post" action="{{ path('app_exemplaire_delete', {'id': exemplaire.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet exemplaire ?');" style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exemplaire.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
