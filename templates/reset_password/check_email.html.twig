{% extends 'base.html.twig' %}

{% block title %}LibraShelf | Email de réinitialisation envoyé{% endblock %}

{% block body %}
<div class="container pt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-4">Email de réinitialisation envoyé</h1>

            <div class="alert alert-success" role="alert">
                <p class="mb-0">
                    Si un compte correspond à votre email, un lien de réinitialisation vous a été envoyé.
                </p>
            </div>

            <div class="card">
                <div class="card-body">
                    <p class="text-muted">
                        Ce lien expirera dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                    </p>

                    <p class="text-muted mb-0">
                        Si vous ne recevez pas d'email, vérifiez votre dossier spam ou
                        <a href="{{ path('app_forgot_password_request') }}">réessayez</a>.
                    </p>
                </div>
            </div>

            <div class="text-center mt-3">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
